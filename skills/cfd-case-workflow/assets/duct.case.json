{
  "schema_version": 1,
  "name": "duct_demo",
  "scenario": "internal",
  "description": "安装自检用矩形直管：25°C 常物性水、稳态层流，非实际产品设计。",
  "geometry": {"length_m": 0.12, "width_m": 0.01, "height_m": 0.01, "segments": 1},
  "physics": {
    "energy": false,
    "turbulence": "Laminar",
    "material": {"name": "Water_demo_25C", "kind": "Liquid", "Density": 997.0, "Viscosity": 0.00089, "SpecialHeat": 4180.0, "ThermalConduct": 0.6},
    "inlet_speed_m_s": 0.05,
    "outlet_gauge_pressure_Pa": 0.0,
    "turbulence_intensity_percent": 5.0,
    "turbulence_viscosity_ratio": 10.0,
    "momentum_scheme": "FirstUpwind"
  },
  "mesh": {"size_m": 0.0025, "threads": 2, "input_units": "m", "prism_layers": 0, "grid_convergence_study": false},
  "solver": {"cores": 2, "max_iterations": 2000, "save_interval": 200, "residual_limit": 1e-5},
  "files": {"mesh_msh": "mesh/model_m.msh", "mesh_cgns": "mesh/model_m.cgns", "mesh_check": "checks/mesh.json", "regions": "regions.json", "qfx": "model.qfx"},
  "validation": {
    "bbox_tolerance_m": 1e-8,
    "skewness_max_limit": 0.98,
    "aspect_ratio_max_limit": 30.0,
    "residual": {"file": "fluid-Residual.dat", "columns": {"continuity": 1e-5, "U.x": 1e-5, "U.y": 1e-5, "U.z": 1e-5}},
    "mass_balance": {"limit_percent": 0.1, "terms": [{"file": "fluid-mass_inlet.dat", "column": "massFlowRate"}, {"file": "fluid-mass_outlet.dat", "column": "massFlowRate"}]},
    "monitors": [{"file": "fluid-pressure_inlet.dat", "column": "p", "tail": 30, "relative_span_limit_percent": 1.0, "absolute_floor": 1.0}],
    "energy_balance": null
  },
  "post": {"zones": ["fluid_main"], "fields": ["p", "U.x", "U.y", "U.z", "U.mag"]},
  "qflux_assertions": [
    {"pointer": "/region/0/solver/time", "equals": 1},
    {"pointer": "/region/0/solver/energy", "equals": false},
    {"pointer": "/region/0/solver/turbModel/type", "equals": 1}
  ]
}
